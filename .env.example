# ---------------------------------------------------------------------------
# CiviqueX environment configuration
# Copy this file to .env and adjust values. The app runs fully in DEMO MODE
# once DATABASE_URL points at a real Postgres database.
# ---------------------------------------------------------------------------

# Hosted PostgreSQL connection string (Neon, Vercel Postgres, Supabase, etc.
# all work — Prisma just needs a standard postgres:// URL). Required: there
# is no SQLite fallback, since Vercel's serverless filesystem is ephemeral.
# Free tier is plenty for this app. Get one from https://neon.tech in ~1
# minute (create a project, copy the "Connection string" — use the "pooled"
# one if offered), or from the Vercel dashboard → Storage → create Postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing secret for session JWTs. MUST be changed to a real random secret
# outside local dev — generate one with: openssl rand -base64 32
AUTH_SECRET="civiquex-local-dev-secret-change-me"

# Vercel Blob store token for evidence media uploads (photos/videos). Set
# automatically in Vercel's environment once a Blob store is connected to
# the project (Vercel dashboard → Storage → create Blob store → Connect
# Project). Leave unset for local dev — media then falls back to local disk
# under storage/uploads, which is fine on your own machine but does NOT work
# on Vercel's read-only production filesystem.
BLOB_READ_WRITE_TOKEN=""

# DATA MODE — "demo" (default) uses the deterministic offline dataset and is
# always safe to run with no network access. "live" would route through the
# DataProvider/MapProvider/AuthorityProvider adapters to real external
# sources; no live provider is wired up in this build (see README §Data
# Providers), so "live" mode will report "External submission unavailable"
# for anything without a real adapter, per the project's non-negotiable rule
# against fabricating government integrations.
DATA_MODE="demo"

# If set to "true", the background demo observation stream (used to drive
# the real-time dashboard/map without a live sensor feed) is enabled. This
# stream is always labeled DEMO STREAM in the UI and never mixed with
# real data.
ENABLE_DEMO_STREAM="true"

# Map tiles: CARTO's free basemaps (no API key required) — built for direct
# embedding and sends the CORS headers WebGL needs; raw tile.openstreetmap.org
# does not, and its usage policy discourages third-party embedding anyway.
NEXT_PUBLIC_MAP_TILE_URL="https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors © CARTO"
